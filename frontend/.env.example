# For local web development (uses Vite proxy):
# VITE_API_BASE_URL=/api

# For Android APK / Mobile Testing on Local Network (replace with your machine's LAN IP or hosted backend):
# VITE_API_BASE_URL=http://192.168.1.50:5001/api

# For Android Emulator:
# VITE_API_BASE_URL=http://10.0.2.2:5001/api

# For Hosted Production / Cloud Backend:
# VITE_API_BASE_URL=https://civora-api.onrender.com/api

